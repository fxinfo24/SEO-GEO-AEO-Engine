# Copy to .env and fill in your project's values. Never commit .env.
# Get these from Supabase Dashboard -> Project Settings -> API.

SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — full DB access, bypasses RLS. Server-side / CLI use only.
# Never expose this in a browser, mobile app, or any client-side context.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
