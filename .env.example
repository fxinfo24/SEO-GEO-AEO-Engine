# Copy to .env and fill in. Never commit .env.
#
# Any PostgreSQL works: Neon, Supabase, RDS, or local. Use a TLS-enabled string
# for hosted providers. For Neon, prefer the *pooled* connection string for the
# CLI and the direct one when running `seo-geo-aeo db-migrate`.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Integration tests only (tests/storage). Point at a throwaway database; each
# test creates and drops its own schema. Example with Docker:
#   docker run -d -e POSTGRES_PASSWORD=test -p 55432:5432 postgres:16-alpine
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:55432/postgres
